{
  "name": "BirdDog PLAY recovery flasher",
  "short_name": "PLAY flasher",
  "description": "Recover a bricked BirdDog PLAY over USB from the browser: pick a firmware image and write it straight to the device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfaf8",
  "theme_color": "#fbfaf8",
  "orientation": "any",
